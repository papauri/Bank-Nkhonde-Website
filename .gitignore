# Environment files
.env
.env.local
.env.production

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup

# PHP specific
vendor/
composer.phar
composer.lock

# Email configuration (contains sensitive SMTP credentials - DO NOT COMMIT)
config/email.config.js
config/email.config.js.backup

# Firebase Functions
functions/node_modules/
functions/.runtimeconfig.json
functions/*.log

# Uploaded proof-of-payment files are member data — never commit them.
# Keep the directory guards (execution-disable .htaccess + anti-listing index).
uploads/proofs/*
!uploads/proofs/.htaccess
!uploads/proofs/index.html
# Playwright MCP browser-test artifacts (page snapshots .yml, console logs,
# and saved .md snapshots) — throwaway verification output, never commit.
.playwright-mcp/

# Screenshots taken while verifying a change in the browser. Throwaway — the
# finding gets written up, the image does not. Scoped to the repo ROOT with a
# leading slash so real assets (assets/favicon.png, and anything under pages/
# or styles/) are unaffected. Eight of these were committed in 25b174e before
# this rule existed.
/*.png
/*.jpg
/*.jpeg
/*.webp

# Exports downloaded during verification (CSV/Excel probes of the export routes).
/*.csv
/*.xlsx
